# Example environment configuration for ArchPilot AI

## Database connection string in SQLAlchemy format
# Example: postgresql+psycopg2://user:password@localhost:5432/archpilot
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/archpilot

## API keys for your LLM provider (OpenAI, Anthropic, etc.)
# Replace with your own API keys when running locally.
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=

## Application settings
APP_NAME=ArchPilotAI
LOG_LEVEL=info
ALLOW_ORIGINS=http://localhost:3000